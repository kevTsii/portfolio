---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow-condensed/600.css';
import '../styles/industry.css';
import '../styles/theme.css';

import { ClientRouter } from 'astro:transitions';

import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { chemin, t, type Lang, type Page } from '../i18n';

interface Props {
  title: string;
  description: string;
  page: Page;
  lang: Lang;
}

const { title, description, page, lang } = Astro.props;
// Adresses absolues sur le domaine défini par `site` (astro.config.mjs).
const absolue = (chemin: string) => new URL(chemin, Astro.site).href;
const canonique = absolue(chemin(lang, page));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonique} />
    <link rel="alternate" hreflang="fr" href={absolue(chemin('fr', page))} />
    <link rel="alternate" hreflang="en" href={absolue(chemin('en', page))} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={absolue(chemin('fr', page))}
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonique} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <!-- Applique le thème avant le premier rendu pour éviter le flash. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('ktr-theme');
        } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = theme;
        // Active les animations qui ont besoin de JavaScript (titre du hero).
        document.documentElement.classList.add('js');

        // Navigation sans rechargement : la page entrante reçoit le thème
        // avant d'être affichée. Écouteur posé une seule fois.
        if (window.ktrThemeSwap) {
          return;
        }
        window.ktrThemeSwap = true;
        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.dataset.theme =
            document.documentElement.dataset.theme;
          event.newDocument.documentElement.classList.add('js');
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t(lang).layout.skipLink}</a>
    <Nav page={page} lang={lang} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
