---
import { SITE } from '../data/site';
import { chemin, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang).footer;
---

<footer class="footer">
  <span>© {new Date().getFullYear()} {SITE.nomComplet}</span>
  <a href={chemin(lang, 'agences')}>{tr.agences}</a>
  <span class="footer-role">{tr.role}</span>
</footer>

<style>
  .footer {
    padding: 24px 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 14px;
    color: var(--color-neutral-600);
  }

  .footer-role {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 20px 16px;
    }
  }
</style>
