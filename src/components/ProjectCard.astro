---
import { Image } from 'astro:assets';

import { chemin, t, type Lang } from '../i18n';
import type { Projet } from '../i18n/projets';
import Corners from './Corners.astro';

interface Props {
  projet: Projet;
  variante: 'accueil' | 'realisations';
  lang: Lang;
  // Titre et texte propres à la page qui affiche la carte (page agences).
  titre?: string;
  texte?: string;
}

const { projet, variante, lang, titre, texte: texteImpose } = Astro.props;
const { data } = projet;
const tr = t(lang);
const corps = projet.entry.body?.trim();
const accueil = variante === 'accueil';
const secteur = tr.secteurs[data.secteur];
const etiquette = accueil ? (data.etiquetteAccueil ?? secteur) : secteur;
const texte = texteImpose ?? (accueil
  ? (data.resumeAccueil ?? data.resume ?? corps)
  : (data.resume ?? corps));
const Tag = accueil ? 'a' : 'article';
---

<Tag
  class:list={['card', 'blueprint', 'project-card', { 'is-link': accueil }]}
  href={accueil ? chemin(lang, 'realisations', projet.id) : undefined}
  id={accueil ? undefined : projet.id}
  data-secteur={accueil ? undefined : data.secteur}
>
  <Corners />
  <div class="duotone project-media">
    {
      data.image ? (
        <Image
          src={data.image}
          alt={data.imageAlt ?? ''}
          widths={[420, 640, 840]}
          sizes="(max-width: 768px) 100vw, 400px"
          class="project-img"
        />
      ) : (
        <div class="project-placeholder" aria-hidden="true">
          <span>{data.nom}</span>
        </div>
      )
    }
  </div>
  <div class="project-body">
    {
      accueil ? (
        <span class="tag tag-accent project-tag">{etiquette}</span>
      ) : (
        <div class="project-meta">
          <span class="tag tag-accent">{etiquette}</span>
          <span class="project-year">{data.annee}</span>
        </div>
      )
    }
    <h3 class="project-title">{titre ?? data.titre}</h3>
    <p class="project-text">{texte}</p>
    {
      !accueil && (
        <div class="project-tech">
          <span class="project-name">{data.nom}</span> · {data.technologies}
        </div>
      )
    }
    {
      !accueil && (
        <button
          type="button"
          class="project-open"
          data-open-projet={projet.id}
          aria-haspopup="dialog"
        >
          {tr.projet.voirDetail}<span class="sr-only"> : {data.nom}</span>{' '}
          <span aria-hidden="true">→</span>
        </button>
      )
    }
  </div>
</Tag>

<style>
  .project-card {
    padding: 0;
    gap: 0;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s;
    scroll-margin-top: calc(var(--nav-offset) + 16px);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    color: inherit;
  }

  .project-card:target {
    border-color: var(--color-accent);
  }

  .project-media {
    height: 190px;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .project-placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    padding: 16px;
    background-color: var(--color-accent-100);
    background-image:
      linear-gradient(var(--color-divider) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-divider) 1px, transparent 1px);
    background-size: 24px 24px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 22px;
    color: var(--color-accent-700);
    text-align: center;
  }

  .project-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .is-link .project-body {
    padding-bottom: 26px;
  }

  .project-tag {
    align-self: flex-start;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .project-year {
    font-size: 14px;
    color: var(--color-neutral-600);
    white-space: nowrap;
  }

  .project-title {
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: normal;
    margin: 0;
  }

  .project-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-neutral-700);
    margin: 0;
    flex: 1;
  }

  .project-tech {
    padding-top: 14px;
    margin-top: 6px;
    border-top: 1px solid var(--color-divider);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-neutral-600);
  }

  .project-name {
    color: var(--color-neutral-700);
  }

  .project-open {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 15px;
    color: var(--color-accent-700);
    cursor: pointer;
  }

  /* Toute la carte ouvre la modale. */
  .project-open::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project-card:hover .project-open {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-card:has(.project-open:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .project-open:focus-visible {
    outline: none;
  }
</style>
