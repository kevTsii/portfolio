---
import Corners from './Corners.astro';

interface Props {
  // Lien mailto construit avec mailto() (src/data/site.ts).
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a href={href} class="blueprint email-btn">
  <Corners />{label}
</a>

<style>
  .email-btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-size: 17px;
    font-weight: 500;
    padding: 15px 26px;
    background: var(--contact-fg);
    color: var(--contact-bg);
    transition: opacity .15s;
  }

  .email-btn:hover {
    color: var(--contact-bg);
    opacity: .88;
  }
</style>
