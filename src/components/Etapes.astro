---
// Étapes numérotées, sur fond sombre (section .section-dark).

interface Props {
  etapes: readonly { titre: string; texte: string }[];
  // Préfixe lu par les lecteurs d'écran ; {n} est le numéro de l'étape.
  prefixe: string;
}

const { etapes, prefixe } = Astro.props;
---

<ol class="steps" style={`--etapes: ${etapes.length}`}>
  {
    etapes.map((etape, i) => (
      <li class="step">
        <span class="step-num" aria-hidden="true">{i + 1}</span>
        <h3 class="step-title">
          <span class="sr-only">{prefixe.replace('{n}', String(i + 1))}</span>
          {etape.titre}
        </h3>
        <p class="step-text">{etape.texte}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(var(--etapes, 4), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--method-num);
  }

  .step {
    padding: 26px 24px 0;
    border-left: 1px solid rgba(242, 242, 243, .2);
  }

  .step:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .step:last-child {
    padding-right: 0;
  }

  .step-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 48px;
    font-weight: 600;
    color: var(--method-num);
    line-height: 1;
    margin-bottom: 14px;
  }

  .step-title {
    font-size: 23px;
    line-height: 1.12;
    letter-spacing: normal;
    margin: 0 0 8px;
  }

  .step-text {
    font-size: 15px;
    line-height: 1.6;
    opacity: .8;
    margin: 0;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step,
    .step:first-child,
    .step:last-child {
      padding: 26px 24px 26px 0;
      border-left: 0;
    }

    .step:nth-child(even) {
      padding-left: 24px;
      border-left: 1px solid rgba(242, 242, 243, .2);
    }

    .step:nth-child(n + 3) {
      border-top: 1px solid rgba(242, 242, 243, .2);
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }

    .step:nth-child(n + 2) {
      border-top: 1px solid rgba(242, 242, 243, .2);
    }
  }
</style>
