---
// Icône Lucide inline, au trait de 1.5 comme dans la maquette.
const icons = import.meta.glob<string>(
  '/node_modules/lucide-static/icons/{sun,moon,menu,x,link,check,copy,arrow-up-right}.svg',
  { query: '?raw', import: 'default', eager: true },
);

interface Props {
  name:
    | 'sun'
    | 'moon'
    | 'menu'
    | 'x'
    | 'link'
    | 'check'
    | 'copy'
    | 'arrow-up-right';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`] ?? '';
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace(/class="[^"]*"/, `class="${className}" aria-hidden="true"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.5"');
---

<Fragment set:html={svg} />
