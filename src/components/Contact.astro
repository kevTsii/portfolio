---
// Section de contact en bas de page : invitation à écrire, lien mailto
// pré-rempli et adresse affichée en clair avec un bouton de copie.
import { SITE, mailto } from '../data/site';
import { t, type Lang } from '../i18n';
import EmailButton from './EmailButton.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  titre: string;
  texte: string;
  bouton: string;
  sujet: string;
  corps: string;
}

const { lang, titre, texte, bouton, sujet, corps } = Astro.props;
const tr = t(lang).contact;
---

<section
  class="section-dark contact"
  id="contact"
  aria-labelledby="contact-title"
>
  <div class="container contact-grid">
    <div>
      <h2 class="contact-title" id="contact-title">{titre}</h2>
      <p class="contact-text">{texte}</p>
      <EmailButton href={mailto(sujet, corps)} label={bouton} />
    </div>
    <dl class="contact-infos">
      <div>
        <dt>{tr.email}</dt>
        <dd class="contact-email">
          <a href={mailto()}>{SITE.email}</a>
          <button
            type="button"
            class="btn btn-ghost contact-copy"
            data-copy-email={SITE.email}
            data-copie={tr.copie}
            data-copie-impossible={tr.copieImpossible}
            aria-label={tr.copier}
            title={tr.copier}
            hidden
          >
            <Icon name="copy" size={16} class="icon-copy" />
            <Icon name="check" size={16} class="icon-check" />
          </button>
          <span class="sr-only" aria-live="polite" data-copy-status></span>
        </dd>
      </div>
      <div>
        <dt>{tr.reponse}</dt>
        <dd>{tr.reponseDelai}</dd>
      </div>
      <div>
        <dt>{tr.lieu}</dt>
        <dd>{tr.lieuTexte}</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  // Bouton icône « Copier l'adresse », affiché seulement si le
  // presse-papiers est disponible (le lien mailto reste le repli). Son
  // libellé, porté par aria-label et title, annonce le résultat.
  function initCopie(): void {
    const bouton = document.querySelector<HTMLButtonElement>(
      '[data-copy-email]',
    );
    const statut = document.querySelector<HTMLElement>('[data-copy-status]');
    if (!bouton || !navigator.clipboard) {
      return;
    }
    const libelle = bouton.getAttribute('aria-label') ?? '';
    const afficher = (texte: string): void => {
      bouton.setAttribute('aria-label', texte);
      bouton.title = texte;
    };
    let minuterie: number | undefined;
    bouton.hidden = false;
    bouton.addEventListener('click', async () => {
      const textes = bouton.dataset;
      let message = textes.copieImpossible ?? libelle;
      try {
        await navigator.clipboard.writeText(textes.copyEmail ?? '');
        message = textes.copie ?? libelle;
        bouton.classList.add('is-copied');
      } catch {
        // Le message d'échec reste affiché.
      }
      afficher(message);
      if (statut) {
        statut.textContent = message;
      }
      window.clearTimeout(minuterie);
      minuterie = window.setTimeout(() => {
        bouton.classList.remove('is-copied');
        afficher(libelle);
        if (statut) {
          statut.textContent = '';
        }
      }, 2000);
    });
  }

  document.addEventListener('astro:page-load', initCopie);
</script>

<style>
  .contact {
    scroll-margin-top: var(--nav-offset);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 56px;
    align-items: center;
    padding-block: 88px;
  }

  .contact-title {
    font-size: 56px;
    line-height: 1.02;
    margin: 0 0 18px;
  }

  .contact-text {
    font-size: 19px;
    line-height: 1.6;
    margin: 0 0 32px;
    max-width: 48ch;
    opacity: .85;
  }

  .contact-infos {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: 16px;
  }

  .contact-infos > div {
    padding: 14px 0;
    border-top: 1px solid var(--contact-line);
  }

  .contact-infos > div:last-child {
    border-bottom: 1px solid var(--contact-line);
  }

  .contact-infos dt {
    font-size: 13px;
    opacity: .7;
    margin-bottom: 3px;
  }

  .contact-infos dd {
    margin: 0;
  }

  .contact-infos a {
    color: inherit;
    text-decoration: none;
  }

  .contact-infos a:hover {
    color: inherit;
    text-decoration: underline;
  }

  .contact-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    overflow-wrap: anywhere;
  }

  .contact-copy {
    width: 32px;
    height: 32px;
    padding: 0;
    margin-left: -6px;
    color: inherit;
    opacity: .85;
  }

  .contact-copy:hover {
    opacity: 1;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  .contact-copy[hidden],
  .contact-copy :global(.icon-check),
  .contact-copy.is-copied :global(.icon-copy) {
    display: none;
  }

  .contact-copy.is-copied :global(.icon-check) {
    display: block;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .contact-grid {
      padding-block: 64px;
    }

    .contact-title {
      font-size: 40px;
    }
  }
</style>
